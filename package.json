{
  "name": "oud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "http://lorem--ipsum.github.io/oud",
  "files": [
    "dist"
  ],
  "main": "dist/oud.umd.cjs",
  "module": "dist/oud.js",
  "types": "dist/index.d.ts",
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d demo"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "classnames": "^2.5.1",
    "immutable-class": "^0.11.4",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "sass": "^1.107.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
